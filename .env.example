# Supabase (public values are safe in the browser; the service role key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lead capture
# Optional random string used to hash visitor IPs before storage.
LEAD_IP_SALT=

# Transactional email (Resend). Emails are skipped until BOTH values below are set.
# EMAIL_FROM must be an address on a domain you have verified in Resend, e.g. "SaniForge <hello@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Where internal lead notifications go (defaults to contact.sani@proton.me).
LEAD_NOTIFY_TO=contact.sani@proton.me

# ---- SEO / domain (see DOMAIN_MIGRATION.md) ----
# Public origin for canonical URLs, og:url, sitemap, robots and JSON-LD. No trailing slash.
# Defaults to https://saniforge.vercel.app when empty.
NEXT_PUBLIC_SITE_URL=
# Set only after the custom domain is live (e.g. saniforge.com). Enables a 301 redirect
# from LEGACY_HOST to this domain for every path.
CUSTOM_DOMAIN=
# Host to redirect away from once CUSTOM_DOMAIN is set. Defaults to saniforge.vercel.app.
LEGACY_HOST=
# VERCEL_ENV is set by Vercel automatically. Anything other than "production"
# (preview, development) is served with noindex and a disallow-all robots.txt.

# Optional: Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=
